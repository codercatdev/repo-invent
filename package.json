{
  "name": "repo-invent",
  "version": "0.1.0",
  "description": "Read a public repo, diagnose its AWS architecture gaps, prescribe a re:Invent 2026 schedule, and export the remediation plan.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "repo-invent": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web": "node dist/web.js",
    "web:dev": "tsx src/web.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
